# Even when `cargo` is on `PATH`, `rustc` might not in some cases. This adds
# ~/.cargo/bin to PATH to address such cases.
if [ -d "${HOME}/.cargo/bin" ]; then
  export PATH="${PATH}:${HOME}/.cargo/bin"
fi

CARGO_VERSION="$(cargo --version)"

if [ $? -ne 0 ]; then
  echo "-------------- ERROR: CONFIGURATION FAILED --------------------"
  echo ""
  echo "The cargo command is not available. To install Rust, please refer"
  echo "to the official instruction:"
  echo ""
  echo "https://www.rust-lang.org/tools/install"
  echo ""
  echo "---------------------------------------------------------------"

  exit 1
fi

# There's a little chance that rustc is not available on PATH while cargo is.
# So, just ignore the error case.
RUSTC_VERSION="$(rustc --version || true)"

# Report the version of Rustc to comply with the CRAN policy
echo "using Rust package manager: '${CARGO_VERSION}'"
echo "using Rust compiler: '${RUSTC_VERSION}'"

append_feature() {
  if [ -z "${CONFIGURE_FEATURES}" ]; then
    CONFIGURE_FEATURES="$1"
  else
    CONFIGURE_FEATURES="${CONFIGURE_FEATURES} $1"
  fi
}

CONFIGURE_FEATURES=""
NO_DEFAULT_FEATURES=""

for arg in "$@"; do
  case "${arg}" in
    --with-rust-features=*)
      value="${arg#*=}"
      value="$(printf '%s' "${value}" | tr ',' ' ')"
      append_feature "${value}"
      ;;
    --without-default-rust-features)
      NO_DEFAULT_FEATURES="--no-default-features"
      ;;
    --enable-gcp)
      append_feature "gcp"
      ;;
    --enable-azure)
      append_feature "azure"
      ;;
    --enable-all-cloud)
      append_feature "cloud"
      ;;
    --enable-altrep)
      append_feature "altrep"
      ;;
    --enable-async-altrep)
      append_feature "async-altrep"
      ;;
    --disable-zip)
      NO_DEFAULT_FEATURES="--no-default-features"
      append_feature "aws"
      ;;
    --help)
      echo "Rzarrs configure options:"
      echo "  --with-rust-features=FEATURES   comma/space separated Cargo features"
      echo "  --without-default-rust-features pass Cargo --no-default-features"
      echo "  --enable-gcp                    enable GCS object-store support"
      echo "  --enable-azure                  enable Azure Blob object-store support"
      echo "  --enable-all-cloud              enable AWS, GCS, and Azure support"
      echo "  --enable-altrep                 enable savvy ALTREP feature"
      echo "  --enable-async-altrep           enable experimental async ALTREP scaffold"
      echo "  --disable-zip                   disable local .zarr.zip support"
      exit 0
      ;;
  esac
done

# allow overriding profile externally (e.g. on CI)
if [ -n "${SAVVY_PROFILE}" ]; then
  PROFILE="${SAVVY_PROFILE}"
# catch DEBUG envvar, which is passed from pkgbuild::compile_dll()
elif [ "${DEBUG}" = "true" ]; then
  PROFILE=dev
else
  PROFILE=release
fi

# e.g. SAVVY_FEATURES="a b" or --with-rust-features=a,b --> Cargo features.
FEATURES="$(printf '%s %s' "${SAVVY_FEATURES}" "${CONFIGURE_FEATURES}" | xargs)"
if [ -n "${FEATURES}" ]; then
  FEATURE_FLAGS="${NO_DEFAULT_FEATURES} --features '${FEATURES}'"
elif [ -n "${NO_DEFAULT_FEATURES}" ]; then
  FEATURE_FLAGS="${NO_DEFAULT_FEATURES}"
fi

# Rtools target selection.
if command -v Rscript >/dev/null 2>&1; then
  R_PLATFORM="$(Rscript -e 'cat(R.version$platform)' 2>/dev/null)"
  R_PLATFORM="$(printf '%s' "${R_PLATFORM}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
else
  R_PLATFORM=""
fi

PROCESSOR="${R_PLATFORM:-${PROCESSOR_ARCHITECTURE:-$(uname -m)}}"

case "${PROCESSOR}" in
  *aarch64*|*arm64*|*aarch64-pc-windows-gnullvm*)
    TARGET="aarch64-pc-windows-gnullvm"
    CARGO_LINKER="aarch64-w64-mingw32.static.posix-gcc.exe"
    ;;
  *x86_64*|*amd64*|*x64*)
    TARGET="x86_64-pc-windows-gnu"
    CARGO_LINKER="x86_64-w64-mingw32.static.posix-gcc.exe"
    ;;
  *)
    TARGET="x86_64-pc-windows-gnu"
    CARGO_LINKER="x86_64-w64-mingw32.static.posix-gcc.exe"
    ;;
esac

sed \
  -e "s/@TARGET@/${TARGET}/" \
  -e "s/@CARGO_LINKER@/${CARGO_LINKER}/" \
  -e "s/@PROFILE@/${PROFILE}/" \
  -e "s/@FEATURE_FLAGS@/${FEATURE_FLAGS}/" \
  src/Makevars.win.in > src/Makevars.win
